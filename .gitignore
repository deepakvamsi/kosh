# Dependencies
node_modules/

# Frontend build output (regenerated by `wails build` / `npm run build`)
cmd/localvault/frontend/dist/
cmd/localvault/frontend/package.json.md5

# Wails / Go build artifacts
cmd/localvault/build/bin/

# Built binaries — distributed via GitHub Releases, never committed to source
cmd/localvault/*.exe
/Kosh.exe
/*.exe
/*.deb
/*.AppImage

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/

# Signing material — never commit certs or passwords
*.pfx
*.p12

# Vault database — contains encrypted user secrets, MUST NOT be committed
*.db
*.db-wal
*.db-shm
vault.db

# Backup archives — encrypted but still sensitive
*.lvbak

# Environment / secret files
.env
.env.*
*.pem
*.key
