# --- Go ---
# Test / coverage output
*.test
*.out
coverage.txt
coverage.html

# --- Wails / desktop build output ---
# Compiled binaries and packaged installers produced by `wails build`.
cmd/localvault/build/bin/
cmd/localvault/build/windows/installer/*.exe
cmd/localvault/build/windows/*.syso
# Note: cmd/localvault/frontend/wailsjs/ is generated but intentionally committed.

# --- Frontend (Node / Vite) ---
node_modules/
cmd/localvault/frontend/dist/
cmd/localvault/frontend/node_modules/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# --- Local vault / secrets (must never be committed) ---
*.db
*.db-wal
*.db-shm
vault.db*
*.kosh
*.kbak

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*~

# --- Release / signing artifacts (kept out of source control) ---
*.pfx
*.p12
SHA256SUMS*.txt
DEPENDENCIES-*.txt
dist/
release/
